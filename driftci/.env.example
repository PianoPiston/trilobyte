# Live official-web scrape and scoped search. Keep the real value outside source control.
CONTEXTDEV_API_KEY=
# Optional: raises GitHub API metadata limits. Never sent to raw.githubusercontent.com or Context.dev.
GITHUB_TOKEN=

# Runtime
DRIFTCI_HOST=127.0.0.1
DRIFTCI_PORT=8100
DRIFTCI_WATCH_INTERVAL_SECONDS=900
DRIFTCI_SCAN_COOLDOWN_SECONDS=30

# Context.dev cache, pacing and local credit controls
DRIFTCI_CONTEXT_CACHE_TTL=21600
CONTEXTDEV_MIN_INTERVAL=6.2
CONTEXTDEV_MAX_SOURCES=6
CONTEXTDEV_DAILY_CREDIT_LIMIT=80

# Selective GitHub source reading. These do NOT limit total repository size.
DRIFTCI_GITHUB_FILE_LIMIT=120
DRIFTCI_GITHUB_BYTE_LIMIT=4000000
DRIFTCI_GITHUB_FILE_BYTE_LIMIT=1000000
DRIFTCI_REPOSITORY_CONNECT_TIMEOUT_SECONDS=90
DRIFTCI_OSV_PACKAGE_LIMIT=32
DRIFTCI_OSV_BATCH_SECONDS=25

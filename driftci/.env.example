# Optional: enables live official-web retrieval through Context.dev.
CONTEXTDEV_API_KEY=
# Optional: enables opening real pull requests in the connected GitHub repository.
GITHUB_TOKEN=
# Runtime
DRIFTCI_HOST=127.0.0.1
DRIFTCI_PORT=8100
DRIFTCI_WATCH_INTERVAL_SECONDS=900
DRIFTCI_SCAN_COOLDOWN_SECONDS=30
# Selective GitHub source reading. These do NOT limit total repository size.
DRIFTCI_GITHUB_FILE_LIMIT=64
DRIFTCI_GITHUB_BYTE_LIMIT=2000000
DRIFTCI_GITHUB_FILE_BYTE_LIMIT=1000000
DRIFTCI_REPOSITORY_CONNECT_TIMEOUT_SECONDS=75
DRIFTCI_OSV_PACKAGE_LIMIT=32
DRIFTCI_OSV_BATCH_SECONDS=25
# Keep secrets outside the repository.
